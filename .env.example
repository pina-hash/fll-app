# fll-app environment. Copy to .env for local work; set the same names in the
# Vercel project for production. Only the PUBLIC_ ones reach the browser.

# Supabase project URL and anon (publishable) key. Read at BUILD time via
# $env/static/public by src/hooks.server.ts and src/routes/+layout.ts -- the
# two places a Supabase client is created. The anon key is safe to ship: every
# row it can see is decided by RLS on the signed-in identity.
#   Local stack:  http://127.0.0.1:54321 and the anon key `supabase status` prints.
#   Production:   Project Settings > API in the Supabase dashboard.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY service-role key. Nothing in this phase reads it; it is reserved
# for a server route that must act outside RLS (none exists yet -- student
# creation and PIN reset are SECURITY DEFINER RPCs, which need no service key).
# Read at runtime via $env/dynamic/private if and when a reader is added, so
# leaving it blank is always safe. NEVER prefix it PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Not environment variables, but configured alongside them:
#
#   Google OAuth for mentors is configured in the Supabase dashboard
#   (Authentication > Providers > Google), restricted to boscotech.edu. The
#   database trigger in supabase/migrations/0002_mentors.sql is the boundary;
#   the dashboard restriction is a convenience.
#
#   Redirect URLs (Authentication > URL Configuration) must include
#   http://localhost:5173/auth/callback and https://<your-domain>/auth/callback.
# ---------------------------------------------------------------------------
